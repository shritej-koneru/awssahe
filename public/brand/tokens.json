{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "AWS Student Builders Group SAHE Design Tokens",
  "version": "1.0.0",
  "color": {
    "background": {
      "primary": { "value": "#000000", "type": "color" },
      "elevated": { "value": "#0b0b0b", "type": "color" },
      "cardDark": { "value": "rgba(13,8,24,0.85)", "type": "color" },
      "cardLight": { "value": "#f5f5f5", "type": "color" },
      "cardLightBorder": { "value": "#000000", "type": "color" }
    },
    "brand": {
      "purple": { "value": "#a855f7", "type": "color" },
      "purpleGlow": { "value": "rgba(168,85,247,0.4)", "type": "color" },
      "purpleDark": { "value": "#0d071b", "type": "color" },
      "purpleMuted": { "value": "rgba(168,85,247,0.18)", "type": "color" }
    },
    "text": {
      "primary": { "value": "#ffffff", "type": "color" },
      "secondary": { "value": "#f5f5f5", "type": "color" },
      "muted": { "value": "#d1d5db", "type": "color" },
      "subtle": { "value": "rgba(255,255,255,0.7)", "type": "color" },
      "inverse": { "value": "#000000", "type": "color" }
    }
  },
  "typography": {
    "fontFamily": {
      "display": { "value": "Bebas Neue, Oswald, sans-serif", "type": "fontFamily" },
      "body": { "value": "Space Grotesk, system-ui, sans-serif", "type": "fontFamily" },
      "mono": { "value": "JetBrains Mono, Courier New, monospace", "type": "fontFamily" }
    },
    "letterSpacing": {
      "tight": { "value": "-0.04em", "type": "letterSpacing" },
      "normal": { "value": "0.01em", "type": "letterSpacing" },
      "wide": { "value": "0.14em", "type": "letterSpacing" },
      "badge": { "value": "0.25em", "type": "letterSpacing" }
    }
  },
  "border": {
    "width": {
      "thin": { "value": "1px", "type": "borderWidth" },
      "medium": { "value": "1.5px", "type": "borderWidth" },
      "heavy": { "value": "3px", "type": "borderWidth" }
    },
    "radius": {
      "none": { "value": "0px", "type": "borderRadius" },
      "sm": { "value": "6px", "type": "borderRadius" },
      "md": { "value": "8px", "type": "borderRadius" },
      "lg": { "value": "14px", "type": "borderRadius" }
    }
  },
  "shadow": {
    "brutalistPurple": { "value": "10px 10px 0px 0px #a855f7", "type": "boxShadow" },
    "brutalistWhite": { "value": "10px 10px 0px 0px #ffffff", "type": "boxShadow" },
    "badgeWhite": { "value": "6px 6px 0px 0px #ffffff", "type": "boxShadow" },
    "glowPurple": { "value": "0px 0px 24px 0px rgba(168,85,247,0.4)", "type": "boxShadow" }
  },
  "animation": {
    "spring": {
      "stiffness": 260,
      "damping": 18
    }
  }
}
